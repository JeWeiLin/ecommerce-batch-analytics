{
  // Use the project's virtualenv (has pyspark, delta-spark, airflow, pytest)
  "python.defaultInterpreterPath": "${workspaceFolder}/venv/bin/python",
  // The `ecommerce` package lives in src/ (same as PYTHONPATH=src at runtime)
  "python.analysis.extraPaths": ["${workspaceFolder}/src", "${workspaceFolder}/tests"],
  "python.testing.pytestEnabled": true,
  "python.testing.pytestArgs": ["-m", "not slow"]
}
